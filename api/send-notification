const admin = require("firebase-admin");

function initFirebase() {
  if (admin.apps.length) {
    return admin.app();
  }

  const serviceAccount = JSON.parse(
    process.env.FIREBASE_SERVICE_ACCOUNT
  );

  return admin.initializeApp({
    credential: admin.credential.cert(serviceAccount)
  });
}

module.exports = async function handler(req, res) {

  if (req.method !== "POST") {
    return res.status(405).json({
      error: "Méthode non autorisée"
    });
  }

  try {

    initFirebase();

    const {
      title,
      message,
      type = "info",
      clickAction = "./notifications.html"
    } = req.body || {};

    if (!message || !message.trim()) {
      return res.status(400).json({
        error: "Message manquant"
      });
    }

    const db = admin.firestore();

    /*
      Récupération des utilisateurs possédant
      un token FCM.
    */

    const snapshot = await db
      .collection("users")
      .get();

    const tokens = [];

    snapshot.forEach(doc => {

      const data = doc.data();

      if (
        data.fcmToken &&
        typeof data.fcmToken === "string"
      ) {
        tokens.push(data.fcmToken);
      }

    });

    if (tokens.length === 0) {

      return res.status(200).json({
        total: 0,
        sent: 0,
        failed: 0,
        message:
          "Aucun appareil FCM enregistré."
      });

    }

    /*
      FCM accepte au maximum 500 tokens
      par envoi multicast.
    */

    let sent = 0;
    let failed = 0;

    const batchSize = 500;

    for (
      let i = 0;
      i < tokens.length;
      i += batchSize
    ) {

      const batch =
        tokens.slice(i, i + batchSize);

      const response =
        await admin.messaging().sendEachForMulticast({

          tokens: batch,

          notification: {
            title:
              title || "ARVEXA School",

            body:
              message
          },

          data: {
            type: String(type),

            clickAction:
              String(clickAction),

            title:
              String(title || "ARVEXA School"),

            body:
              String(message)
          },

          webpush: {

            notification: {

              icon: "/icon.png",

              badge: "/icon.png",

              tag:
                "arvexa-" +
                Date.now()
            },

            fcmOptions: {

              link:
                clickAction
            }

          }

        });

      sent += response.successCount;
      failed += response.failureCount;
    }


    /*
      Enregistrement dans l'historique.
    */

    await db
      .collection("notifications")
      .add({

        title:
          title || "ARVEXA School",

        message,

        type,

        clickAction,

        sent,

        failed,

        total: tokens.length,

        createdAt:
          admin.firestore.FieldValue.serverTimestamp(),

        source: "admin"

      });


    return res.status(200).json({

      success: true,

      total: tokens.length,

      sent,

      failed

    });


  } catch (error) {

    console.error(
      "FCM ERROR:",
      error
    );

    return res.status(500).json({

      error:
        error.message ||
        "Erreur serveur"

    });

  }

};
